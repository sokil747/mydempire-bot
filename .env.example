# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Hive account username (lowercase, no @)
HIVE_USERNAME=stranger27

# Hive posting key (use only for low-risk operations)
HIVE_POSTING_KEY=

# MydEmpire backend API base
MDE_API_BASE=https://mydempire-backend-1.onrender.com

# ---- optional overrides (defaults used if unset) ----

# Daily time (HH:MM, VPS local time) for scheduled daily tasks. Default: 02:00
# GOODS_CLAIM_CRON_TIME=02:00

# Telegram chat id to receive the daily 02:00 report and notifications.
# Leave unset to only log. Find your id via @userinfobot.
# GOODS_CLAIM_NOTIFY_CHAT_ID=

# Separate chat id for the full daily report (falls back to the above).
# DAILY_REPORT_CHAT_ID=

# Empire operation type, EMP budget, and ops per day. Defaults: LOCAL_SUPPLY, 25, 3
# OPS_TYPE=LOCAL_SUPPLY
# OPS_BUDGET=25
# OPS_PER_DAY=3

# Factory fulfillment type to start after claiming and buffer seconds.
# Defaults: GRAND_CONSIGNMENT, 2
# FULFILLMENT_TYPE=GRAND_CONSIGNMENT
# FULFILLMENT_CLAIM_BUFFER_SECONDS=2

# Auto bulk-redeem all available goods on the inventory tab after claiming.
# Default: true (set to false to disable)
AUTO_REDEMPTION=true

# Daily statistics to Google Sheets: enabled on by default (set to false to
# disable), spreadsheet id (from the sheet URL), and the service-account
# JSON key path that was granted edit access on the sheet.
# STATS_ENABLED=true
# STATS_SPREADSHEET_ID=
# STATS_SERVICE_ACCOUNT_FILE=/var/www/mydempire/gservice.json
